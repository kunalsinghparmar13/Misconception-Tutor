# Copy to .env for local/docker use, or enter these in your host's dashboard. Never commit real values.
APP_ENV=production
LLM_ONLY_MODEL=1

# Where your model server is (printed by the Kaggle notebook / Modal deploy). See docs/DEPLOY_FREE.md.
LLM_BACKEND_URL=
LLM_BACKEND_TOKEN=

# Protects admin/audit routes. Use a long random string: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
